# Copy this file to .env before running `docker compose up`.
#   cp .env.docker.example .env
# .env is gitignored. Never commit real secrets.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# --- Database (used by both the web container and the db container) ---
DB_NAME=polymath_core
DB_USER=polymath
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Host port to expose MySQL on (container port is always 3306).
DB_PORT_HOST=3306

# Host port to expose the web app on (container port is always 8000).
WEB_PORT_HOST=8000

# --- App ---
PROD_URL=http://localhost:8000/
QR_METHOD_NAME=checkInView
